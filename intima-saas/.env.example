# Supabase (banco de dados + auth do painel de lojistas)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL pública desta aplicação, usada para montar webhook_url/redirect_url
# mandados para a processadora de pagamento. Em produção, o domínio real;
# em dev, geralmente http://localhost:3000 (mas o webhook só chega se essa
# URL for alcançável pela internet — ver README sobre teste local).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Gateway de pagamento — ver src/lib/payments/README.md
# "mock": sandbox, não move dinheiro (padrão até haver conta configurada).
# "infinitepay": Checkout Integrado da InfinitePay (Pix/cartão). Não exige
# chave de API global aqui — cada lojista conecta a própria conta em
# /admin/pagamento (tenants.infinitepay_handle), porque o dinheiro cai
# direto na conta dele, não na da plataforma.
PAYMENT_PROVIDER=mock
