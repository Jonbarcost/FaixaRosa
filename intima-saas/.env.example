# Supabase (banco de dados + auth do painel de lojistas)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Gateway de pagamento (alto risco / adult-friendly) — ver src/lib/payments/README.md
# Enquanto não há contrato com uma adquirente de alto risco, deixe "mock".
PAYMENT_PROVIDER=mock

# Preenchido quando houver contrato com processadora real (ex: Livexa Pay, ou
# adquirente de alto risco internacional). Nunca commitar valores reais aqui.
PAYMENT_PROVIDER_API_KEY=
PAYMENT_PROVIDER_WEBHOOK_SECRET=
